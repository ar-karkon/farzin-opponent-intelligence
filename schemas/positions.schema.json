{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "FOI version 1 target-player decision",
  "required": [
    "sample_id",
    "game_id",
    "date",
    "target_fide_id",
    "ply_index",
    "fen_before",
    "prior_moves_uci",
    "legal_moves_uci",
    "actual_move_uci",
    "white_elo_at_game",
    "black_elo_at_game",
    "split"
  ],
  "properties": {
    "sample_id": {
      "type": "string"
    },
    "game_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "target_fide_id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "ply_index": {
      "type": "integer",
      "minimum": 0
    },
    "target_color": {
      "enum": ["white", "black"]
    },
    "phase": {
      "enum": ["opening", "middlegame", "endgame"]
    },
    "opening_key": {
      "type": "string",
      "description": "Past-only UCI prefix; does not use ECO tags or future moves."
    },
    "fen_before": {
      "type": "string"
    },
    "prior_moves_uci": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prior_positions_fen": {
      "type": "array",
      "maxItems": 7,
      "items": {"type": "string"},
      "description": "Up to seven FENs immediately preceding fen_before; excludes the current position."
    },
    "legal_moves_uci": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "actual_move_uci": {
      "type": "string"
    },
    "white_elo_at_game": {
      "type": "integer"
    },
    "black_elo_at_game": {
      "type": "integer"
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "historical_test",
        "post_release_test",
        "quarantine"
      ]
    },
    "model_input_context_version": {
      "type": "string"
    }
  }
}
